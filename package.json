{
  "name": "album-person-finder",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that finds photos of a person inside an open Google Photos album, using on-device face embeddings.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "fetch-models": "node scripts/fetch-models.mjs",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node scripts/browser-smoke.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "eval:models": "node scripts/eval-models.mjs",
    "fetch-test-images": "node scripts/fetch-test-images.mjs"
  },
  "devDependencies": {
    "@tensorflow/tfjs-backend-wasm": "4.22.0",
    "@types/chrome": "0.3.5",
    "@types/node": "24.19.2",
    "@vladmandic/human": "3.3.6",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "puppeteer": "25.14.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
