{
  "manifest_version": 3,
  "name": "Album Person Finder",
  "version": "0.1.0",
  "description": "Find photos of a person in the Google Photos album you have open. Face matching runs entirely on your device.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Open Album Person Finder",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "permissions": ["sidePanel", "scripting", "storage"],
  "host_permissions": ["https://photos.google.com/*", "https://*.googleusercontent.com/*"],
  "content_scripts": [
    {
      "matches": ["https://photos.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
